public import Mathlib
public import Lib.AlgebraicTopology.SingularHomology.Orientation.HomologyBall

/-!
# The local homology covering of a manifold

For a manifold `M` modelled on `ℝⁿ`, the local homology groups `H_n(M, M ∖ {x})` assemble into a
covering space of `M` (Hatcher, *Algebraic Topology*, §3.3, the space `M_R` for `R = ℤ`):

* `ManifoldOrientation.LocalHomologyCover M n := Σ x : M, localHomology M x n`, topologized
  by the *sheets* `sheet K β = {⟨y, β|_y⟩ | y ∈ interior K}` for a compact homology ball `K`
  and `β ∈ H_n(M, M ∖ K)` (`instTopologicalSpaceLocalHomologyCover`);
* `ManifoldOrientation.proj : LocalHomologyCover M n → M`, the projection;
* `ManifoldOrientation.isCoveringMap_proj : IsCoveringMap (proj M n)`.

The key point is that two sheets agree on an open set (`isOpen_agreementSet`): if the restrictions
of `β` and `β'` agree at one point `y`, they agree on a smaller homology ball around `y`, by the
injectivity of the local restriction there.  Over the interior of a homology ball `K` the sheets
`sheet K β`, `β ∈ H_n(M, M ∖ K)`, partition the preimage, which gives the local trivialization
`trivialization hK hKb` with the discrete fibre `Fibre K = H_n(M, M ∖ K)`.

## Main definitions and results

* `ManifoldOrientation.LocalHomologyCover`, `ManifoldOrientation.sheet`,
  `ManifoldOrientation.proj`.
* `ManifoldOrientation.isOpen_agreementSet`, `ManifoldOrientation.isOpen_sheet`,
  `ManifoldOrientation.continuous_proj`.
* `ManifoldOrientation.trivialization`, `ManifoldOrientation.isCoveringMap_proj`.
* `ManifoldOrientation.continuousOn_sectionMap` : the section `y ↦ ⟨y, β|_y⟩` of a sheet is
  continuous on `interior K`.

## References

* [Allen Hatcher, *Algebraic Topology*][hatcher02], §3.3, the covering space `M_R → M`

## Tags

local homology, covering space, orientation
-/

open Set Function Topology

@[expose] public noncomputable section

namespace ManifoldOrientation

open RelativeSingularHomology

variable {M : Type} [TopologicalSpace M] {n : ℕ}

/-! ### The total space and its sheets -/

/-- The total space of the local homology covering: pairs `(x, μ)` with `μ ∈ H_n(M, M ∖ {x})`. -/
def LocalHomologyCover (M : Type) [TopologicalSpace M] (n : ℕ) : Type :=
  Σ x : M, localHomology M x n

/-- The projection of the local homology covering. -/
def proj (M : Type) [TopologicalSpace M] (n : ℕ) : LocalHomologyCover M n → M := Sigma.fst

/-- A point of the total space. -/
abbrev LocalHomologyCover.mk (x : M) (μ : localHomology M x n) : LocalHomologyCover M n := ⟨x, μ⟩

@[simp] theorem proj_mk (x : M) (μ : localHomology M x n) : proj M n (LocalHomologyCover.mk x μ) = x :=
  rfl

/-- The sheet of `β ∈ H_n(M, M ∖ K)` over `interior K`: the points `⟨y, β|_y⟩`. -/
def sheet (K : Set M) (β : RelativeHomology M Kᶜ n) : Set (LocalHomologyCover M n) :=
  { p | ∃ hp : p.1 ∈ interior K, p.2 = localRestriction (interior_subset hp) n β }

theorem mem_sheet_mk {K : Set M} (β : RelativeHomology M Kᶜ n) {y : M} (hy : y ∈ interior K)
    (μ : localHomology M y n) :
    LocalHomologyCover.mk y μ ∈ sheet K β ↔ μ = localRestriction (interior_subset hy) n β :=
  ⟨fun ⟨_, h⟩ => h, fun h => ⟨hy, h⟩⟩

theorem mk_mem_sheet {K : Set M} (β : RelativeHomology M Kᶜ n) {y : M} (hy : y ∈ interior K) :
    LocalHomologyCover.mk y (localRestriction (interior_subset hy) n β) ∈ sheet K β :=
  ⟨hy, rfl⟩

theorem sheet_subset_preimage (K : Set M) (β : RelativeHomology M Kᶜ n) :
    sheet K β ⊆ proj M n ⁻¹' interior K :=
  fun _ hp => hp.1

/-- The generating sheets: over compact homology balls (in degree `n`). -/
def generatingSheets (M : Type) [TopologicalSpace M] (n : ℕ) : Set (Set (LocalHomologyCover M n)) :=
  { S | ∃ (K : Set M) (_ : IsCompact K) (_ : IsHomologyBall M n K) (β : RelativeHomology M Kᶜ n),
      S = sheet K β }

/-- The topology of the local homology covering, generated by the sheets. -/
instance instTopologicalSpaceLocalHomologyCover : TopologicalSpace (LocalHomologyCover M n) :=
  TopologicalSpace.generateFrom (generatingSheets M n)

theorem isOpen_sheet {K : Set M} (hK : IsCompact K) (hKb : IsHomologyBall M n K)
    (β : RelativeHomology M Kᶜ n) : IsOpen (sheet K β) :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨K, hK, hKb, β, rfl⟩

/-! ### Agreement of sheets is open -/

/-- The set of points of `interior K ∩ interior K'` at which the restrictions of `β` and `β'`
agree. -/
def agreementSet (K K' : Set M) (β : RelativeHomology M Kᶜ n) (β' : RelativeHomology M K'ᶜ n) :
    Set M :=
  { y | ∃ (h : y ∈ interior K) (h' : y ∈ interior K'),
      localRestriction (interior_subset h) n β = localRestriction (interior_subset h') n β' }

/-! ### Section maps and fibres -/

open scoped Classical in
/-- The section `y ↦ ⟨y, β|_y⟩` of a sheet, extended by `0` outside `K`. -/
def sectionMap (K : Set M) (β : RelativeHomology M Kᶜ n) (y : M) : LocalHomologyCover M n :=
  if hy : y ∈ K then LocalHomologyCover.mk y (localRestriction hy n β) else LocalHomologyCover.mk y 0

theorem sectionMap_of_mem {K : Set M} (β : RelativeHomology M Kᶜ n) {y : M} (hy : y ∈ K) :
    sectionMap K β y = LocalHomologyCover.mk y (localRestriction hy n β) := by
  unfold sectionMap
  rw [dif_pos hy]

theorem sectionMap_fst (K : Set M) (β : RelativeHomology M Kᶜ n) (y : M) :
    (sectionMap K β y).1 = y := by
  unfold sectionMap
  split_ifs <;> rfl

theorem sectionMap_mem_sheet {K : Set M} (β : RelativeHomology M Kᶜ n) {y : M} (hy : y ∈ interior K) :
    sectionMap K β y ∈ sheet K β := by
  rw [sectionMap_of_mem β (interior_subset hy)]
  exact mk_mem_sheet β hy

/-- The preimage of a sheet under a section map, inside `interior K`, is an agreement set. -/
theorem preimage_sheet_sectionMap (K K' : Set M) (β : RelativeHomology M Kᶜ n)
    (β' : RelativeHomology M K'ᶜ n) :
    interior K ∩ sectionMap K β ⁻¹' sheet K' β' = agreementSet K K' β β' := by
  ext y
  constructor
  · rintro ⟨hy, hy'⟩
    rw [mem_preimage, sectionMap_of_mem β (interior_subset hy)] at hy'
    obtain ⟨hyK', hβ⟩ := hy'
    exact ⟨hy, hyK', hβ⟩
  · rintro ⟨hy, hy', hβ⟩
    refine ⟨hy, ?_⟩
    rw [mem_preimage, sectionMap_of_mem β (interior_subset hy)]
    exact ⟨hy', hβ⟩

/-- The fibre of the trivialization over a homology ball `K`: `H_n(M, M ∖ K)` with the discrete
topology. -/
def Fibre (M : Type) [TopologicalSpace M] (n : ℕ) (K : Set M) : Type := RelativeHomology M Kᶜ n

instance (K : Set M) : TopologicalSpace (Fibre M n K) := ⊥
instance (K : Set M) : DiscreteTopology (Fibre M n K) := ⟨rfl⟩
instance (K : Set M) : Zero (Fibre M n K) := ⟨(0 : RelativeHomology M Kᶜ n)⟩

/-- The class over `K` determined by a point of the total space over `K` (a homology ball). -/
def classOf {K : Set M} (hKb : IsHomologyBall M n K) (p : LocalHomologyCover M n) (hp : p.1 ∈ K) :
    Fibre M n K :=
  (LinearEquiv.ofBijective _ (hKb p.1 hp)).symm p.2

theorem localRestriction_classOf {K : Set M} (hKb : IsHomologyBall M n K) (p : LocalHomologyCover M n)
    (hp : p.1 ∈ K) : localRestriction hp n (classOf hKb p hp) = p.2 :=
  (LinearEquiv.ofBijective _ (hKb p.1 hp)).apply_symm_apply p.2

theorem classOf_mk_localRestriction {K : Set M} (hKb : IsHomologyBall M n K) {y : M} (hy : y ∈ K)
    (β : Fibre M n K) : classOf hKb (LocalHomologyCover.mk y (localRestriction hy n β)) hy = β :=
  (LinearEquiv.ofBijective _ (hKb y hy)).symm_apply_apply β

open scoped Classical in
/-- The forward map of the trivialization over `K`. -/
def trivToFun {K : Set M} (hKb : IsHomologyBall M n K) (p : LocalHomologyCover M n) : M × Fibre M n K :=
  if hp : p.1 ∈ K then (p.1, classOf hKb p hp) else (p.1, 0)

/-- The inverse map of the trivialization over `K`. -/
def trivInvFun (K : Set M) (β : Fibre M n K) : M → LocalHomologyCover M n :=
  sectionMap K β

theorem trivInvFun_fst (K : Set M) (β : Fibre M n K) (y : M) : (trivInvFun K β y).1 = y :=
  sectionMap_fst K β y

theorem trivInvFun_of_mem (K : Set M) (β : Fibre M n K) {y : M} (hy : y ∈ K) :
    trivInvFun K β y = LocalHomologyCover.mk y (localRestriction hy n β) :=
  sectionMap_of_mem β hy

theorem trivToFun_of_mem {K : Set M} (hKb : IsHomologyBall M n K) (p : LocalHomologyCover M n)
    (hp : p.1 ∈ K) : trivToFun hKb p = (p.1, classOf hKb p hp) := by
  unfold trivToFun
  rw [dif_pos hp]

theorem trivToFun_fst {K : Set M} (hKb : IsHomologyBall M n K) (p : LocalHomologyCover M n) :
    (trivToFun hKb p).1 = p.1 := by
  unfold trivToFun
  split_ifs <;> rfl

/-- On a sheet over `interior K`, the forward map of the trivialization is `p ↦ (p.1, β)`. -/
theorem trivToFun_eq_on_sheet {K : Set M} (hKb : IsHomologyBall M n K) (β : RelativeHomology M Kᶜ n)
    {p : LocalHomologyCover M n} (hp : p ∈ sheet K β) : trivToFun hKb p = (p.1, β) := by
  obtain ⟨y, μ⟩ := p
  obtain ⟨hpK, hpβ⟩ := hp
  change y ∈ interior K at hpK
  change μ = localRestriction (interior_subset hpK) n β at hpβ
  subst hpβ
  rw [trivToFun_of_mem hKb ⟨y, localRestriction (interior_subset hpK) n β⟩ (interior_subset hpK)]
  exact congrArg _ (classOf_mk_localRestriction hKb _ β)

section Manifold

variable [ChartedSpace (EuclideanSpace ℝ (Fin n)) M] [T2Space M]

/-- Two sheets that agree at a point agree near it: the agreement set is open. -/
theorem isOpen_agreementSet (K K' : Set M) (β : RelativeHomology M Kᶜ n)
    (β' : RelativeHomology M K'ᶜ n) : IsOpen (agreementSet K K' β β') := by
  rw [isOpen_iff_mem_nhds]
  rintro y ⟨hy, hy', hβ⟩
  obtain ⟨L, _, hLsub, hyL, hLb⟩ := exists_isHomologyBall (n := n) y
    (Filter.inter_mem (isOpen_interior.mem_nhds hy) (isOpen_interior.mem_nhds hy')) n
  have hLK : L ⊆ K := hLsub.trans (inter_subset_left.trans interior_subset)
  have hLK' : L ⊆ K' := hLsub.trans (inter_subset_right.trans interior_subset)
  -- the two restrictions to `L` agree at `y`, hence are equal
  have hyL' : y ∈ L := interior_subset hyL
  have heq : restriction (compl_subset_compl.mpr hLK) n β =
      restriction (compl_subset_compl.mpr hLK') n β' := by
    apply (hLb y hyL').1
    rw [← LinearMap.comp_apply, localRestriction_comp_restriction hLK hyL',
      ← LinearMap.comp_apply, localRestriction_comp_restriction hLK' hyL']
    exact hβ
  apply Filter.mem_of_superset (isOpen_interior.mem_nhds hyL)
  intro z hz
  have hzL : z ∈ L := interior_subset hz
  refine ⟨hLsub hzL |>.1, hLsub hzL |>.2, ?_⟩
  have h₁ := LinearMap.congr_fun (localRestriction_comp_restriction hLK hzL n) β
  have h₂ := LinearMap.congr_fun (localRestriction_comp_restriction hLK' hzL n) β'
  rw [LinearMap.comp_apply] at h₁ h₂
  rw [← h₁, ← h₂, heq]

/-! ### Continuity of the section maps -/

/-- The section map of a sheet is continuous on `interior K`. -/
theorem continuousOn_sectionMap (K : Set M) (β : RelativeHomology M Kᶜ n) :
    ContinuousOn (sectionMap K β) (interior K) := by
  rw [continuousOn_open_iff isOpen_interior]
  intro t ht
  induction ht with
  | basic S hS =>
    obtain ⟨K', _, _, β', rfl⟩ := hS
    rw [preimage_sheet_sectionMap]
    exact isOpen_agreementSet K K' β β'
  | univ => simp only [preimage_univ, inter_univ]; exact isOpen_interior
  | inter s t _ _ hs ht =>
    rw [preimage_inter, inter_inter_distrib_left]
    exact hs.inter ht
  | sUnion S _ hS =>
    rw [preimage_sUnion, inter_iUnion₂]
    exact isOpen_biUnion hS

theorem continuousOn_trivInvFun (K : Set M) (β : Fibre M n K) :
    ContinuousOn (trivInvFun K β) (interior K) :=
  continuousOn_sectionMap K β

/-! ### The projection is continuous -/

/-- Every point of the total space lies in a generating sheet over a ball inside any given
neighbourhood of its projection. -/
theorem exists_generating_sheet_mem (p : LocalHomologyCover M n) {U : Set M} (hU : U ∈ 𝓝 p.1) :
    ∃ (K : Set M) (_ : IsCompact K) (_ : IsHomologyBall M n K) (β : RelativeHomology M Kᶜ n),
      K ⊆ U ∧ p ∈ sheet K β := by
  obtain ⟨K, hK, hKU, hpK, hKb⟩ := exists_isHomologyBall (n := n) p.1 hU n
  obtain ⟨β, hβ⟩ := (hKb p.1 (interior_subset hpK)).2 p.2
  exact ⟨K, hK, hKb, β, hKU, hpK, hβ.symm⟩

theorem continuous_proj : Continuous (proj M n) := by
  rw [continuous_def]
  intro U hU
  rw [isOpen_iff_mem_nhds]
  intro p hp
  obtain ⟨K, hK, hKb, β, hKU, hpS⟩ := exists_generating_sheet_mem p (hU.mem_nhds hp)
  exact Filter.mem_of_superset ((isOpen_sheet hK hKb β).mem_nhds hpS)
    ((sheet_subset_preimage K β).trans (preimage_mono (interior_subset.trans hKU)))

/-! ### The local trivializations -/

/-- The local trivialization of the local homology covering over the interior of a compact
homology ball. -/
def trivialization {K : Set M} (hK : IsCompact K) (hKb : IsHomologyBall M n K) :
    Bundle.Trivialization (Fibre M n K) (proj M n) where
  toFun := trivToFun hKb
  invFun q := trivInvFun K q.2 q.1
  source := proj M n ⁻¹' interior K
  target := interior K ×ˢ univ
  map_source' p hp := ⟨by rw [trivToFun_fst]; exact hp, trivial⟩
  map_target' q hq := by
    change (trivInvFun K q.2 q.1).1 ∈ interior K
    rw [trivInvFun_fst]
    exact hq.1
  left_inv' p hp := by
    have hpK : p.1 ∈ K := interior_subset hp
    change trivInvFun K (trivToFun hKb p).2 (trivToFun hKb p).1 = p
    rw [trivToFun_of_mem hKb p hpK]
    change trivInvFun K (classOf hKb p hpK) p.1 = p
    rw [trivInvFun_of_mem K _ hpK, localRestriction_classOf]
    rfl
  right_inv' q hq := by
    rw [trivInvFun_of_mem K _ (interior_subset hq.1),
      trivToFun_of_mem hKb (LocalHomologyCover.mk q.1 (localRestriction (interior_subset hq.1) n q.2))
        (interior_subset hq.1), classOf_mk_localRestriction]
  open_source := continuous_proj.isOpen_preimage _ isOpen_interior
  open_target := isOpen_interior.prod isOpen_univ
  continuousOn_toFun := by
    apply continuousOn_of_locally_continuousOn
    intro p hp
    obtain ⟨β, hβ⟩ := (hKb p.1 (interior_subset hp)).2 p.2
    refine ⟨sheet K β, isOpen_sheet hK hKb β, ⟨hp, hβ.symm⟩, ?_⟩
    refine (continuous_proj.prodMk (continuous_const (y := (show Fibre M n K from β)))).continuousOn.congr ?_
    intro q hq
    exact trivToFun_eq_on_sheet hKb β hq.2
  continuousOn_invFun := by
    apply continuousOn_of_locally_continuousOn
    rintro ⟨y, β⟩ hq
    refine ⟨univ ×ˢ {β}, isOpen_univ.prod (isOpen_discrete _), ⟨trivial, rfl⟩, ?_⟩
    have hcont : ContinuousOn (fun q : M × Fibre M n K => trivInvFun K β q.1) (interior K ×ˢ univ) :=
      (continuousOn_trivInvFun K β).comp continuousOn_fst (fun _ hq => hq.1)
    refine (hcont.mono (fun _ hq => hq.1)).congr ?_
    rintro ⟨y', β'⟩ ⟨_, _, hβ'⟩
    change β' = β at hβ'
    subst hβ'
    rfl
  baseSet := interior K
  open_baseSet := isOpen_interior
  source_eq := rfl
  target_eq := rfl
  proj_toFun p _ := trivToFun_fst hKb p

/-- **The local homology covering is a covering space** (Hatcher, §3.3). -/
theorem isCoveringMap_proj : IsCoveringMap (proj M n) := by
  have hball : ∀ x : M, ∃ K : Set M, IsCompact K ∧ x ∈ interior K ∧ IsHomologyBall M n K := by
    intro x
    obtain ⟨K, hK, _, hxK, hKb⟩ := exists_isHomologyBall (n := n) x (Filter.univ_mem) n
    exact ⟨K, hK, hxK, hKb⟩
  choose K hK hxK hKb using hball
  exact IsCoveringMap.mk (proj M n) (fun x => Fibre M n (K x))
    (fun x => trivialization (hK x) (hKb x)) hxK

end Manifold

end ManifoldOrientation
