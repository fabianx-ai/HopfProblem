@HigherHurewicz.hurewiczMap_eq_second : ∀ {X : Type} [inst : TopologicalSpace X] (x : X),
  HigherHurewicz.hurewiczMap x = SecondHurewicz.hurewiczMap x
@HigherHurewicz.hurewiczMap_injective : ∀ {X : Type} [inst : TopologicalSpace X] [SimplyConnectedSpace X] (x : X)
  {m : ℕ}, (∀ (j : ℕ), 2 ≤ j → j < m + 2 → Subsingleton (π_ j X x)) → Function.Injective ⇑(HigherHurewicz.hurewiczMap x)
@HigherHurewicz.factorMap_homotopy_apply : ∀ {n : ℕ} (hn : 0 < n) {X : Type u_1} [inst : TopologicalSpace X] {x : X}
  {p q : ↑(GenLoop (Fin n) X x)} (H : (↑p).HomotopyRel (↑q) (Cube.boundary (Fin n))) (t : ↑unitInterval)
  (u : Fin n → ↑unitInterval),
  (Degree.SphereCube.factorMap_homotopy hn H) (t, (Degree.SphereCube.quotient n) u) = H (t, u)
@HigherHurewicz.factorMap_homotopyRel : {n : ℕ} →
  (hn : 0 < n) →
    {X : Type u_1} →
      [inst : TopologicalSpace X] →
        {x : X} →
          {p q : ↑(GenLoop (Fin n) X x)} →
            (↑p).HomotopyRel (↑q) (Cube.boundary (Fin n)) →
              (Degree.SphereCube.factorMap hn p).HomotopyRel (Degree.SphereCube.factorMap hn q)
                {Degree.SphereCube.point n}
@HigherHurewicz.basedSphereCube : {n : ℕ} →
  {X : Type} →
    [inst : TopologicalSpace X] →
      {x : X} → (f : C(↑(Degree.SphereCube.Sphere n), X)) → f (Degree.SphereCube.point n) = x → ↑(GenLoop (Fin n) X x)
@HigherHurewicz.factorMap_basedSphereCube : ∀ {n : ℕ} (hn : 0 < n) {X : Type} [inst : TopologicalSpace X] {x : X}
  (f : C(↑(Degree.SphereCube.Sphere n), X)) (hf : f (Degree.SphereCube.point n) = x),
  Degree.SphereCube.factorMap hn (HigherHurewicz.basedSphereCube f hf) = f
@HigherHurewicz.basedSphereCube_homologyClass : ∀ {m : ℕ} {X : Type} [inst : TopologicalSpace X] {x : X}
  (f : C(↑(Degree.SphereCube.Sphere (m + 2)), X)) (hf : f (Degree.SphereCube.point (m + 2)) = x),
  HigherHurewicz.cubeHomologyClass (HigherHurewicz.basedSphereCube f hf) =
    (SingularMayerVietoris.singularHomologyMap f (m + 2))
      (HigherHurewicz.cubeHomologyClass (Degree.SphereCube.quotientLoop (m + 2)))
@HigherHurewicz.sphere_homotopicRel_of_topClass_eq : ∀ {m : ℕ} {X : Type} [inst : TopologicalSpace X]
  [SimplyConnectedSpace X] {x : X},
  (∀ (j : ℕ), 2 ≤ j → j < m + 2 → Subsingleton (π_ j X x)) →
    ∀ (f g : C(↑(Degree.SphereCube.Sphere (m + 2)), X)),
      f (Degree.SphereCube.point (m + 2)) = x →
        g (Degree.SphereCube.point (m + 2)) = x →
          (SingularMayerVietoris.singularHomologyMap f (m + 2))
                (HigherHurewicz.cubeHomologyClass (Degree.SphereCube.quotientLoop (m + 2))) =
              (SingularMayerVietoris.singularHomologyMap g (m + 2))
                (HigherHurewicz.cubeHomologyClass (Degree.SphereCube.quotientLoop (m + 2))) →
            f.HomotopicRel g {Degree.SphereCube.point (m + 2)}
@HigherHurewicz.exists_basepoint_adjustment : ∀ {n : ℕ},
  0 < n →
    ∀ {Y : Type u_1} [inst : TopologicalSpace Y] {y : Y} (u : C(↑(Degree.SphereCube.Sphere n), Y))
      (P : Path (u (Degree.SphereCube.point n)) y), ∃ v, v (Degree.SphereCube.point n) = y ∧ u.Homotopic v
@HigherHurewicz.sphere_homotopic_id_of_topClass : ∀ {m : ℕ}
  (g : C(↑(Degree.SphereCube.Sphere (m + 2)), ↑(Degree.SphereCube.Sphere (m + 2)))),
  (SingularMayerVietoris.singularHomologyMap g (m + 2))
        (HigherHurewicz.cubeHomologyClass (Degree.SphereCube.quotientLoop (m + 2))) =
      HigherHurewicz.cubeHomologyClass (Degree.SphereCube.quotientLoop (m + 2)) →
    g.Homotopic (ContinuousMap.id ↑(Degree.SphereCube.Sphere (m + 2)))
@HigherHurewicz.right_inverse_is_left_inverse : ∀ {m : ℕ} {X : Type} [inst : TopologicalSpace X]
  (F : C(↑(Degree.SphereCube.Sphere (m + 2)), X)) (g : C(X, ↑(Degree.SphereCube.Sphere (m + 2)))),
  Function.Injective ⇑(SingularMayerVietoris.singularHomologyMap F (m + 2)) →
    (F.comp g).Homotopic (ContinuousMap.id X) →
      (g.comp F).Homotopic (ContinuousMap.id ↑(Degree.SphereCube.Sphere (m + 2)))
