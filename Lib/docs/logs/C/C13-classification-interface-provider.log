  {X : Type u_1} →
    [inst : TopologicalSpace X] →
      (f : C(↑(SingularChains.Simplex n), X)) →
        (h : C(↑unitInterval × SecondHurewicz.SimplyConnected.SimplexBoundary n, X)) →
          (∀ (s : SecondHurewicz.SimplyConnected.SimplexBoundary n), h (0, s) = f ↑s) →
            C(↑unitInterval × ↑(SingularChains.Simplex n), X)
@SecondHurewicz.SimplyConnected.extendBoundaryHomotopy_bottom : ∀ {n : ℕ} {X : Type u_1} [inst : TopologicalSpace X]
  (f : C(↑(SingularChains.Simplex n), X)) (h : C(↑unitInterval × SecondHurewicz.SimplyConnected.SimplexBoundary n, X))
  (h0 : ∀ (s : SecondHurewicz.SimplyConnected.SimplexBoundary n), h (0, s) = f ↑s) (s : ↑(SingularChains.Simplex n)),
  (SecondHurewicz.SimplyConnected.extendBoundaryHomotopy f h h0) (0, s) = f s
@SecondHurewicz.SimplyConnected.extendBoundaryHomotopy_side : ∀ {n : ℕ} {X : Type u_1} [inst : TopologicalSpace X]
  (f : C(↑(SingularChains.Simplex n), X)) (h : C(↑unitInterval × SecondHurewicz.SimplyConnected.SimplexBoundary n, X))
  (h0 : ∀ (s : SecondHurewicz.SimplyConnected.SimplexBoundary n), h (0, s) = f ↑s) (t : ↑unitInterval)
  (s : SecondHurewicz.SimplyConnected.SimplexBoundary n),
  (SecondHurewicz.SimplyConnected.extendBoundaryHomotopy f h h0) (t, ↑s) = h (t, s)
@SingularHomology.homotopic_homologyMap : ∀ {X Y : Type} [inst : TopologicalSpace X] [inst_1 : TopologicalSpace Y]
  {f g : C(X, Y)},
  f.Homotopic g →
    ∀ (n : ℕ), SingularMayerVietoris.singularHomologyMap f n = SingularMayerVietoris.singularHomologyMap g n
@SingularHomology.singularHomologyMap_comp : ∀ {X Y Z : Type} [inst : TopologicalSpace X] [inst_1 : TopologicalSpace Y]
  [inst_2 : TopologicalSpace Z] (f : C(X, Y)) (g : C(Y, Z)) (n : ℕ),
  SingularMayerVietoris.singularHomologyMap (g.comp f) n =
    SingularMayerVietoris.singularHomologyMap g n ∘ₗ SingularMayerVietoris.singularHomologyMap f n
