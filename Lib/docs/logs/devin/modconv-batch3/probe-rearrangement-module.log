Mathoverflow1973.NativeEuclideanEmbedding.contMDiff_normalProjection.{u_1, u_2} {E : Type u_1} {M : Type u_2}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace M] [ChartedSpace E M] (e : NativeEuclideanEmbedding E M)
