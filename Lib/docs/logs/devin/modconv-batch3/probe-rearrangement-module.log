Mathoverflow1973.SmallPerturbation.bumpTranslation_apply.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] {β : E → ℝ} {k : NNReal} (hs : ContDiff ℝ (↑⊤) β) (hβ : LipschitzWith k β) (a : E)
  (ha : k * ‖a‖₊ < 1) (x : E) : (SmallPerturbation.bumpTranslation hs hβ a ha) x = x + β x • a
