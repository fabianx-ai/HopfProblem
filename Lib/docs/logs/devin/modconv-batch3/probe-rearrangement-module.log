Mathoverflow1973.ManifoldImmersion.exists_immersion_on_compact_rel.{u_1, u_2, u_3} {G : Type u_1} {H : Type u_2}
  {N : Type u_3} [NormedAddCommGroup G] [NormedSpace ℝ G] [FiniteDimensional ℝ G] [TopologicalSpace H]
  {J : ModelWithCorners ℝ G H} [J.Boundaryless] [TopologicalSpace N] [ChartedSpace H N] [IsManifold J (↑⊤) N]
  [T2Space N] (f : C(PlaneImmersion.Plane, N)) (hf : ContMDiff (modelWithCornersSelf ℝ PlaneImmersion.Plane) J ↑⊤ ⇑f)
  (hdim : 5 ≤ Module.finrank ℝ G) {K L C : Set PlaneImmersion.Plane} (hK : IsCompact K) (hL : IsCompact L)
  (hinj : ∀ x ∈ K, Function.Injective ⇑(mfderiv% ⇑f x)) (hC : IsClosed C) (hdis : Disjoint L C) :
  ∃ g,
    ContMDiff (modelWithCornersSelf ℝ PlaneImmersion.Plane) J ↑⊤ ⇑g ∧
      f.HomotopicRel g C ∧ ∀ x ∈ K ∪ L, Function.Injective ⇑(mfderiv% ⇑g x)
Mathoverflow1973.exists_tubularNeighborhood_in_open_of_embedded_closedBall.{u_1, u_2, u_3} {E : Type u_1} {M : Type u_2}
  {D : Type u_3} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [TopologicalSpace M]
  [ChartedSpace E M] [IsManifold (modelWithCornersSelf ℝ E) (↑⊤) M] [T2Space M] [CompactSpace M] [NormedAddCommGroup D]
  [InnerProductSpace ℝ D] [FiniteDimensional ℝ D] {f : D → M}
  (hf : ContMDiff (modelWithCornersSelf ℝ D) (modelWithCornersSelf ℝ E) (↑⊤) f)
  (hinj : Set.InjOn f (Metric.closedBall 0 1)) (hi : ∀ x ∈ Metric.closedBall 0 1, Function.Injective ⇑(mfderiv% f x))
  (n : ℕ) (hcodim : Module.finrank ℝ D + n = Module.finrank ℝ E) {O : Set M} (hO : IsOpen O)
  (hfO : Set.MapsTo f (Metric.closedBall 0 1) O) :
  ∃ ε,
    0 < ε ∧
      ∃ Φ,
        Metric.closedBall 0 1 ×ˢ Metric.closedBall 0 ε ⊆ Φ.source ∧
          (∀ x ∈ Metric.closedBall 0 1, ↑Φ.toPartialEquiv (x, 0) = f x) ∧ Φ.target ⊆ O
Mathoverflow1973.AdaptedWindows.attaching_basin_iff.{u_1, u_2} {E : Type u_1} {M : Type u_2} [NormedAddCommGroup E]
  [NormedSpace ℝ E] [TopologicalSpace M] [ChartedSpace E M] [IsManifold (modelWithCornersSelf ℝ E) (↑⊤) M] [T2Space M]
  {f : M → ℝ} (S : AdaptedWindows E f) (hf : ContMDiff (modelWithCornersSelf ℝ E) (modelWithCornersSelf ℝ ℝ) (↑⊤) f)
  (p : ↑(ManifoldMorse.criticalPoints E f)) (x : (S.data p).LowerLevel) :
  Filter.Tendsto (fun t => S.flow.toFun t ↑x) Filter.atBot (nhds ↑p) ↔ x ∈ Set.range ⇑(S.data p).surgery.attachingSphere
Mathoverflow1973.MorseCancellation.nativeMorseIndex_eq_chart.{u_1, u_2} {E : Type u_1} {M : Type u_2}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace M] [ChartedSpace E M] {f : M → ℝ} {p : M}
  (c : ManifoldMorse.SignedMorseChart f p) :
  MorseCancellation.nativeMorseIndex E f p = Module.finrank ℝ c.NegativeCoordinates
Mathoverflow1973.NativeEuclideanEmbedding.tangentNormalEquiv.{u_1, u_2} {E : Type u_1} {M : Type u_2}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace M] [ChartedSpace E M] (e : NativeEuclideanEmbedding E M)
