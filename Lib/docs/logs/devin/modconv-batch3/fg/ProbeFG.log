@Path.exists_partition_unitInterval_of_open_cover : ∀ {X : Type u_1} [inst : TopologicalSpace X] {ι : Type u_2}
  {c : ι → Set X} {a : X},
  (∀ (i : ι), IsOpen (c i)) →
    Set.univ ⊆ ⋃ i, c i →
      ∀ (γ : Path a a),
        ∃ n t,
          t 0 = 0 ∧ t (Fin.last (n + 1)) = 1 ∧ ∀ (k : Fin (n + 1)), ∃ i, ⇑γ '' Set.uIcc (t k.castSucc) (t k.succ) ⊆ c i
@Path.Homotopic.exists_loops_homotopic_concat_of_open_cover : ∀ {X : Type u_1} [inst : TopologicalSpace X]
  {ι : Type u_2} {c : ι → Set X} {a : X},
  (∀ (i : ι), IsOpen (c i)) →
    Set.univ ⊆ ⋃ i, c i →
      (∀ (i j : ι), IsPathConnected (c i ∩ c j)) →
        (∀ (i : ι), a ∈ c i) →
          ∀ (γ : Path a a),
            ∃ n D, (Path.concat (fun x => a) D).Homotopic γ ∧ ∀ (k : Fin (n + 1)), ∃ i, Set.range ⇑(D k) ⊆ c i
