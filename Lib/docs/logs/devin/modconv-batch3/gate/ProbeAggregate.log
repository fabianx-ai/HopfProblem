  [TopologicalSpace M] [ChartedSpace E M] [IsManifold (modelWithCornersSelf ℝ E) (↑⊤) M] (f : M → ℝ) :
  Type (max u_1 u_2)
MorseCancellation.nativeMorseIndex : (E : Type u_1) →
  [inst : NormedAddCommGroup E] →
    [NormedSpace ℝ E] → {M : Type u_2} → [inst_2 : TopologicalSpace M] → [ChartedSpace E M] → (M → ℝ) → M → ℕ
@ManifoldImmersion.exists_immersion_on_compact_rel : ∀ {G : Type u_1} {H : Type u_2} {N : Type u_3}
  [inst : NormedAddCommGroup G] [inst_1 : NormedSpace ℝ G] [FiniteDimensional ℝ G] [inst_3 : TopologicalSpace H]
  {J : ModelWithCorners ℝ G H} [J.Boundaryless] [inst_5 : TopologicalSpace N] [inst_6 : ChartedSpace H N]
  [IsManifold J (↑⊤) N] [T2Space N] (f : C(PlaneImmersion.Plane, N)),
  ContMDiff (modelWithCornersSelf ℝ PlaneImmersion.Plane) J ↑⊤ ⇑f →
    5 ≤ Module.finrank ℝ G →
      ∀ {K L C : Set PlaneImmersion.Plane},
        IsCompact K →
          IsCompact L →
            (∀ x ∈ K, Function.Injective ⇑(mfderiv% ⇑f x)) →
              IsClosed C →
                Disjoint L C →
                  ∃ g,
                    ContMDiff (modelWithCornersSelf ℝ PlaneImmersion.Plane) J ↑⊤ ⇑g ∧
                      f.HomotopicRel g C ∧ ∀ x ∈ K ∪ L, Function.Injective ⇑(mfderiv% ⇑g x)
@exists_tubularNeighborhood_in_open_of_embedded_closedBall : ∀ {E : Type u_1} {M : Type u_2} {D : Type u_3}
  [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [FiniteDimensional ℝ E] [inst_3 : TopologicalSpace M]
  [inst_4 : ChartedSpace E M] [IsManifold (modelWithCornersSelf ℝ E) (↑⊤) M] [T2Space M] [CompactSpace M]
  [inst_8 : NormedAddCommGroup D] [inst_9 : InnerProductSpace ℝ D] [FiniteDimensional ℝ D] {f : D → M},
  ContMDiff (modelWithCornersSelf ℝ D) (modelWithCornersSelf ℝ E) (↑⊤) f →
    Set.InjOn f (Metric.closedBall 0 1) →
      (∀ x ∈ Metric.closedBall 0 1, Function.Injective ⇑(mfderiv% f x)) →
        ∀ (n : ℕ),
          Module.finrank ℝ D + n = Module.finrank ℝ E →
            ∀ {O : Set M},
              IsOpen O →
                Set.MapsTo f (Metric.closedBall 0 1) O →
                  ∃ ε,
                    0 < ε ∧
                      ∃ Φ,
                        Metric.closedBall 0 1 ×ˢ Metric.closedBall 0 ε ⊆ Φ.source ∧
                          (∀ x ∈ Metric.closedBall 0 1, ↑Φ.toPartialEquiv (x, 0) = f x) ∧ Φ.target ⊆ O
@SmoothMorseLemma.diffeomorphToPartialDiffeomorph : {E : Type u_1} →
  {F : Type u_2} →
    {H : Type u_3} →
      {H' : Type u_4} →
        {X : Type u_5} →
          {Y : Type u_6} →
            [inst : NormedAddCommGroup E] →
              [inst_1 : NormedSpace ℝ E] →
                [inst_2 : TopologicalSpace H] →
                  {I : ModelWithCorners ℝ E H} →
                    [inst_3 : NormedAddCommGroup F] →
                      [inst_4 : NormedSpace ℝ F] →
                        [inst_5 : TopologicalSpace H'] →
                          {J : ModelWithCorners ℝ F H'} →
                            [inst_6 : TopologicalSpace X] →
                              [inst_7 : ChartedSpace H X] →
                                [inst_8 : TopologicalSpace Y] →
                                  [inst_9 : ChartedSpace H' Y] → Diffeomorph I J X Y ↑⊤ → PartialDiffeomorph I J X Y ↑⊤
@exists_partialDiffeomorph_of_isLocalDiffeomorphAt : ∀ {E : Type u_1} {F : Type u_2} {H : Type u_3} {H' : Type u_4}
  {X : Type u_5} {Y : Type u_6} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [inst_2 : TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} [inst_3 : NormedAddCommGroup F] [inst_4 : NormedSpace ℝ F] [inst_5 : TopologicalSpace H']
  {J : ModelWithCorners ℝ F H'} [inst_6 : TopologicalSpace X] [inst_7 : ChartedSpace H X] [inst_8 : TopologicalSpace Y]
  [inst_9 : ChartedSpace H' Y] {f : X → Y} {x : X},
  IsLocalDiffeomorphAt I J (↑⊤) f x → ∃ φ, x ∈ φ.source ∧ Set.EqOn f (↑φ.toPartialEquiv) φ.source
