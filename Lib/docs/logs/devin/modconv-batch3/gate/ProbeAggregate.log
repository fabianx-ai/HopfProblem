@PeriodTorusHigherHomology.circleProductMap : {X Y : Type} →
  [inst : TopologicalSpace X] →
    [inst_1 : TopologicalSpace Y] →
      C(X, Y) → C(SingularHomology.CircleTopology.Circle × X, SingularHomology.CircleTopology.Circle × Y)
@PeriodTorusHigherHomology.circleProductHomologyEquiv_symm_naturality : ∀ {X Y : Type} [inst : TopologicalSpace X]
  [inst_1 : TopologicalSpace Y] (f : C(X, Y)) (n : ℕ)
  (a : ↑(SingularMayerVietoris.SingularHomology X (n + 1)) × ↑(SingularMayerVietoris.SingularHomology X n)),
  (SingularMayerVietoris.singularHomologyMap (PeriodTorusHigherHomology.circleProductMap f) (n + 1))
      ((SingularHomology.circleProductHomologyEquiv X n).symm a) =
    (SingularHomology.circleProductHomologyEquiv Y n).symm
      ((SingularMayerVietoris.singularHomologyMap f (n + 1)) a.1, (SingularMayerVietoris.singularHomologyMap f n) a.2)
@PeriodTorusHigherHomology.crossProductCycles_natural : ∀ {X Y X' Y' : Type} [inst : TopologicalSpace X]
  [inst_1 : TopologicalSpace Y] [inst_2 : TopologicalSpace X'] [inst_3 : TopologicalSpace Y'] (f : C(X, X'))
  (g : C(Y, Y')) (n : ℕ) (a : ↥(SingularMayerVietoris.ModuleHomology.Cycle (SingularChains.singularComplex X) 1))
  (b : ↥(SingularMayerVietoris.ModuleHomology.Cycle (SingularChains.singularComplex Y) n)),
  (SingularMayerVietoris.ModuleHomology.mapCycles (SingularChains.singularChainMap (f.prodMap g)) (n + 1))
      (((SingularHomology.crossProductCycles X Y n) a) b) =
    ((SingularHomology.crossProductCycles X' Y' n)
        ((SingularMayerVietoris.ModuleHomology.mapCycles (SingularChains.singularChainMap f) 1) a))
      ((SingularMayerVietoris.ModuleHomology.mapCycles (SingularChains.singularChainMap g) n) b)
@PeriodTorusHigherHomology.crossProductHomology_natural : ∀ {X Y X' Y' : Type} [inst : TopologicalSpace X]
  [inst_1 : TopologicalSpace Y] [inst_2 : TopologicalSpace X'] [inst_3 : TopologicalSpace Y'] (f : C(X, X'))
  (g : C(Y, Y')) (n : ℕ) (a : ↑(HomologicalComplex.homology (SingularChains.singularComplex X) 1))
  (b : ↑(HomologicalComplex.homology (SingularChains.singularComplex Y) n)),
  (ModuleCat.Hom.hom (HomologicalComplex.homologyMap (SingularChains.singularChainMap (f.prodMap g)) (n + 1)))
      (((SingularHomology.crossProductHomology X Y n) a) b) =
    ((SingularHomology.crossProductHomology X' Y' n)
        ((ModuleCat.Hom.hom (HomologicalComplex.homologyMap (SingularChains.singularChainMap f) 1)) a))
      ((ModuleCat.Hom.hom (HomologicalComplex.homologyMap (SingularChains.singularChainMap g) n)) b)
@PeriodTorusHigherHomology.crossProductHomology_snd : ∀ {X Y : Type} [inst : TopologicalSpace X]
  [inst_1 : TopologicalSpace Y] (n : ℕ) (a : ↑(SingularMayerVietoris.SingularHomology X 1))
  (b : ↑(SingularMayerVietoris.SingularHomology Y n)),
  (SingularMayerVietoris.singularHomologyMap ContinuousMap.snd (n + 1))
      (((SingularHomology.crossProductHomology X Y n) a) b) =
    0
