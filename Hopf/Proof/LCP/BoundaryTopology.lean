def PeriodFamily.Homology.circleTopDegreeCoordinates :
    SingularMayerVietoris.SingularHomology
        ((PeriodTorusHigherHomology.CircleTopology.Circle) ×
          PeriodTorusHigherHomology.ProductTorus 3)
        4 ≃ₗ[ℤ]
      ℤ :=
