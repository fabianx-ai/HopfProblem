theorem PeriodFamily.FlatTorus.periodVector_injective : Function.Injective periodVector := by
  intro c d h
  ext i
  have hi : (c i : ℝ) = (d i : ℝ) := congrFun h i
  exact_mod_cast hi

theorem PeriodFamily.FlatTorus.periodVector_mem_standardLattice (c : PeriodLattice) :
