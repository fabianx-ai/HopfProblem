              C(RealTorus₄, RealTorus₄))
            a) =
        _
    rw [PeriodFamily.FlatTorus.singularH1Equiv_inducedHomology_triangle]
    cases j
    · rw [SpecialPeriods.Triangle.ellipticGenerator,
        SpecialPeriods.triangleDualRepresentation_generator₁_matrix]
      rfl
    · rw [SpecialPeriods.Triangle.ellipticGenerator,
        SpecialPeriods.triangleDualRepresentation_generator₂_matrix]
      rfl

