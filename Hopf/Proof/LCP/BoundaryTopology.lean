  · intro u
    apply Subtype.ext
    exact SpecialPeriods.EllipticAttachingMeridians.interpolate_zero f _
  · intro u
    apply Subtype.ext
    change
      SpecialPeriods.EllipticAttachingMeridians.interpolate f 1
