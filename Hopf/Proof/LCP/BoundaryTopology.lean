        (specialRegularFamilyMarkedMeridianClass Bool.true)⁻¹ =
      specialRegularFamilyMarkedLatticeHom (Multiplicative.ofAdd (A₂ *ᵥ v)) := by
  rw [specialRegularFamilyMarkedMeridian_conjugation]
