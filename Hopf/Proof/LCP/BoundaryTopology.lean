          n).symm
  apply
    exact_of_linearEquiv_squares _ _ _ _ (LinearEquiv.refl ℤ _) (starOverlapHomologyEquiv n)
      (starPairHomologyEquiv n) _ (starLeftHomologyMap_comparison n) hraw
