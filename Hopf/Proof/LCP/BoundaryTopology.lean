    w := by
    change
      -((v : FibreLattice) 1 + (w : FibreLattice) 1) =
        -(v : FibreLattice) 1 + -(w : FibreLattice) 1
    exact neg_add _ _
  map_smul' k
    v := by
    change -(k * (v : FibreLattice) 1) = k * (-(v : FibreLattice) 1)
    ring

