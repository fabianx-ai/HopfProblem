      ⟨periodVector c, mkQ_periodVector c⟩ := by
  apply
    quotientCovering.isCoveringMap.monodromy_eq_of_map_eq
      (Path.Homotopic.Quotient.mk (Path.segment (0 : RealPlane₄) (periodVector c)))
  apply congrArg Path.Homotopic.Quotient.mk
  ext t
  rfl

