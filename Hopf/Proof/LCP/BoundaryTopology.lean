  · simpa only [halfFordNormalizedBoundaryParam_zero] using
      (halfFordNormalizedBoundaryParam_strictMono.le_iff_le (a := 0) (b := t)).symm
  · simpa only [halfFordNormalizedBoundaryParam_one] using
