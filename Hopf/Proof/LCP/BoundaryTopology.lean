  obtain ⟨s, hs⟩ := CuspAttaching.exists_small_exponential
  obtain ⟨x, hx⟩ := CuspAttaching.exists_surjective_overlap_basepoint s hs
  let := liftedPatch_regular_inter_pathConnectedSpace (Option.none : Puncture)
