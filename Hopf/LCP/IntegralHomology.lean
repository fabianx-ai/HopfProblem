def PeriodTorusTypeOneOne.coordinateValue {R : Type*} [CommRing R] (E : Fin 6 → R)
    (x y : Fin 4 → R) : R :=
  E 0 * (x 0 * y 1 - x 1 * y 0) + E 1 * (x 0 * y 2 - x 2 * y 0) + E 2 * (x 0 * y 3 - x 3 * y 0) +
        E 3 * (x 1 * y 2 - x 2 * y 1) +
      E 4 * (x 1 * y 3 - x 3 * y 1) +
    E 5 * (x 2 * y 3 - x 3 * y 2)

