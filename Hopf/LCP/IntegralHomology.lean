@[simp]
theorem Elliptic.HigherHomology.periodCircleHomologyEquiv_fibre (j : Elliptic.Kind)
    (p : Elliptic.FixedPeriod j) (n : ℕ)
    (a :
      SingularMayerVietoris.SingularHomology (PeriodTorusHigherHomology.ProductTorus 3) (n + 1)) :
