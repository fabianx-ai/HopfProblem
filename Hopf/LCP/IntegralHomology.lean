theorem CuspBoundaryGammaZero.cuspRealEquiv_cons_zero (x : Fin 3 → ℝ) :
    SpecialPeriods.CuspFamily.cuspRealEquiv 1 (Fin.cons 0 x) =
      Fin.cons 0 ![x 0, x 0 + x 1, x 2] := by
  rw [SpecialPeriods.CuspFamily.cuspRealEquiv_apply]
  ext i
  fin_cases i <;>
