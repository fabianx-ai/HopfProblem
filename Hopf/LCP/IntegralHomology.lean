                SpecialPeriods.specialPeriodMap_generator₁
                SpecialPeriods.specialPeriodMap_generator₂)).Space) =>
        SingularMayerVietoris.singularHomologyMap f (n + 1))
      (untwistedRegularMap_comp_shear j τ)
