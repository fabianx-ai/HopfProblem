theorem ThreefoldHomology.SecondDegree.cuspWangOne_first_two_zero
    (a :
      LinearMap.ker
        (MappingTorusHomology.wangDifference (ThreefoldOverlapMappingTorus.monodromy Option.none)
          1)) :
    PeriodFamily.FlatTorus.singularH1Equiv a.val 0 = 0 ∧
