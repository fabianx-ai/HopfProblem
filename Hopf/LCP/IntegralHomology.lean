        (originalAffineNorm j 3 (splitCircleClassThree j)) =
      match j with
      | .three => ![3, -1, 2, 0]
      | .four => ![-4, 2, -2, 0] := by
  rw [originalAffineNorm_h3_coordinates, splitCircleClassThree_coordinates]
  cases j
  · rw [originalNormMatrixThree_three]
    decide
  · rw [originalNormMatrixThree_four]
