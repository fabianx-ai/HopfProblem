def CuspBoundaryTopVanishing.gammaBoundaryHeightHomotopy (D : SpecialPeriods.CuspFamily.Data)
    (h₀ h₁ : ThreefoldOverlapMappingTorus.Cusp.Height D.radius) :
    (gammaBoundaryToFull D h₀).Homotopy (gammaBoundaryToFull D h₁)
    where
