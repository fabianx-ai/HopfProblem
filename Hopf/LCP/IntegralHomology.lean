private theorem CuspBoundaryTopVanishing.axisAnnulusContractFormula_gauge_mo1973_29730 (a : ℝ)
    (ha : 0 ≤ a) (ha1 : a < 1) (s : unitInterval) (x : AxisAnnulus a) :
