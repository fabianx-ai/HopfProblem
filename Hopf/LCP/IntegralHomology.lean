@[simp]
theorem SpecialPeriods.Threefold.VerticalAction.Factor.AdditiveFlow.act_inv_act {M : Type*}
    (F : SpecialPeriods.Threefold.VerticalAction.Factor.AdditiveFlow M) (u : ℂˣ) (x : M) :
