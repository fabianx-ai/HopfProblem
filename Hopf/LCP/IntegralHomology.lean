    canonicalPositiveLift b (t : ℝ) = PeriodFamily.Meridians.compatibleMeridianLift b t := by
  calc
    _ = clockwisePeriodicLift b ((unitInterval.symm t : ℝ) + (-1 : ℝ)) := by
      rw [canonicalPositiveLift_apply, unitInterval.coe_symm_eq]
      congr 1
