theorem PeriodFamily.Boundary.EllipticTopFibre.surfacePeriodCoverCircleBoundary_flat
    (j : Elliptic.Kind) (p : Elliptic.FixedPeriod j)
    (a : SingularMayerVietoris.SingularHomology RealTorus₄ 4) :
