def ThreefoldHomology.FourthSource.cuspCoordinates (c3 c4 : ℤ) (x y : Lattice) : Lattice :=
  ![0, 0, -y 2 - y 1, 3 * sourceV_mo1973_29517 c4 y - 4 * sourceU_mo1973_29516 c3 x y]

