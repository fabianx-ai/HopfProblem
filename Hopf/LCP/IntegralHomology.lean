    p :=
    ((ThreefoldOverlapMappingTorus.Cusp.puncturedProductHomeomorph D).symm
        (ThreefoldOverlapMappingTorus.Cusp.heightContraction D.radius h₀ (p.1, h₁),
          CuspBoundaryGammaZero.boundaryMap p.2)).val
