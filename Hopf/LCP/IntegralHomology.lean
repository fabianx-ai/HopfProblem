theorem PeriodFamily.Boundary.ellipticBoundaryFrame_inv_wangBoundary (j : Elliptic.Kind)
    (v : Lattice) (n : ℕ)
    (a :
      SingularMayerVietoris.SingularHomology (MappingTorus.Torus (Elliptic.flatTorusAffine j v))
        (n + 1)) :
