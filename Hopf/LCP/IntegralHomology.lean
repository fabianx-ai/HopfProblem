def
  PeriodFamily.Boundary.EllipticGaugeLinearization.nativeRegularBoundaryGaugeLinearizationHomotopy
    (j : Elliptic.Kind) (τ : ℝ) :
    (PeriodFamily.Boundary.nativeRegularBoundaryMap j τ).Homotopy
