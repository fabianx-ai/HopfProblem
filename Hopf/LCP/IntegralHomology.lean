            (MappingTorusHomology.wangBoundary ThreefoldOverlapMappingTorus.Cusp.monodromy 3 a),
        -MappingTorusHomology.wangBoundary ThreefoldOverlapMappingTorus.Cusp.monodromy 3 a) :=
