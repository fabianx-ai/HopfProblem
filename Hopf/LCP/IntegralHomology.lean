theorem CuspNegation.permute_holomorphic : ContDiff ℂ ω permute :=
  contDiff_pi.mpr fun j => contDiff_apply ℂ ℂ j.rev

theorem CuspNegation.time_permute (z : ToricCharts.CoordinateSpace 3) :
