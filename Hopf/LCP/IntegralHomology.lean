theorem ThreefoldHomology.FourthSource.fourCoordinates_source (c3 c4 : ℤ) (x y : Lattice)
    (hxy : (x, y) ∈ LinearMap.ker TrianglePeriodFamilyHomologyLattice.deltaThree) :
