def ThreefoldHomology.ThirdSource.sourcePair (c3 c4 : ℤ) (a3 a4 : Fin 2 → ℤ) (v : Fin 6 → ℤ) :
    (Fin 6 → ℤ) × (Fin 6 → ℤ) :=
