theorem PeriodFamily.GammaZero.upperFamily_union_lowerFamily
    (D : PeriodFamily.Data ℂ SpecialPeriods.TriangleRegularPoint) :
    (upperFamily D : Set (Space D)) ∪ lowerFamily D = Set.univ := by
  apply Set.eq_univ_of_forall
  intro x
