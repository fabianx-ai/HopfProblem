def SpecialPeriods.Threefold.VerticalAction.Factor.AdditiveFlow.equiv {M : Type*}
    (F : SpecialPeriods.Threefold.VerticalAction.Factor.AdditiveFlow M) (u : ℂˣ) : M ≃ M
    where
