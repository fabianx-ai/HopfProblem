  have hdescWf (x : M) (hx : x ∉ Smale.ManifoldMorse.criticalPoints E f) :
    mvfderiv 𝓘(ℝ, E) f x (W x) < 0 :=
    (Degree.FlowTimeChange.descending_height_div_const_iff (hf.mdifferentiableAt (by simp)) hs
